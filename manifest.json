{
  "manifest_version": 3,
  "name": "SelectPilot",
  "description": "Privacy-first local execution layer for selected text, powered by Ollama",
  "version": "1.0.0",
  "minimum_chrome_version": "127",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png",
    "256": "assets/icon256.png",
    "512": "assets/icon512.png"
  },
  "permissions": ["activeTab", "storage", "scripting", "sidePanel"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Open SelectPilot",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "open-selectpilot": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Command+Shift+S" },
      "description": "Open SelectPilot for the current selection"
    }
  }
}
