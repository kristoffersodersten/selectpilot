#!/bin/sh
set -eu

CONSOLE_USER="$(stat -f '%Su' /dev/console)"
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ]; then
  echo "A logged-in macOS user is required." >&2
  exit 1
fi

USER_HOME="$(dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory | awk '{print $2}')"
USER_ID="$(id -u "$CONSOLE_USER")"
SOURCE_ROOT="/Library/Application Support/SelectPilot"
RUN_DIR="$USER_HOME/Library/Application Support/SelectPilot/run"
LOG_DIR="$USER_HOME/Library/Logs/SelectPilot"
AGENT_DIR="$USER_HOME/Library/LaunchAgents"
AGENT_PATH="$AGENT_DIR/com.selectpilot.bridge.plist"
HASH="$(shasum -a 256 "$SOURCE_ROOT/server/nano_server.py" | awk '{print $1}')"
PROFILE_VALUES="$(sudo -u "$CONSOLE_USER" /usr/bin/python3 - "$SOURCE_ROOT/server" <<'PY'
import sys
sys.path.insert(0, sys.argv[1])
from runtime_profiles import get_runtime_profile, recommend_runtime_profile
profile = get_runtime_profile(recommend_runtime_profile()["recommended_profile"])
print(f"{profile.generation_model}|{profile.embedding_model}|{profile.num_ctx}")
PY
)"
IFS='|' read -r OLLAMA_MODEL OLLAMA_EMBED_MODEL OLLAMA_NUM_CTX <<EOF
$PROFILE_VALUES
EOF

install -d -m 700 -o "$CONSOLE_USER" "$RUN_DIR" "$LOG_DIR" "$AGENT_DIR"
sed \
  -e "s|__PROJECT_ROOT__|$SOURCE_ROOT|g" \
  -e "s|__RUN_DIR__|$RUN_DIR|g" \
  -e "s|__LOG_DIR__|$LOG_DIR|g" \
  -e "s|__BINARY_HASH__|$HASH|g" \
  -e "s|__OLLAMA_BASE_URL__|http://127.0.0.1:11434|g" \
  -e "s|__OLLAMA_MODEL__|$OLLAMA_MODEL|g" \
  -e "s|__OLLAMA_EMBED_MODEL__|$OLLAMA_EMBED_MODEL|g" \
  -e "s|__OLLAMA_NUM_CTX__|$OLLAMA_NUM_CTX|g" \
  -e "s|__ENTITLEMENT_AUTHORITY_URL__|https://license.selectpilot.app|g" \
  "$SOURCE_ROOT/launchd/com.selectpilot.bridge.plist.template" > "$AGENT_PATH"
chown "$CONSOLE_USER" "$AGENT_PATH"
chmod 600 "$AGENT_PATH"

launchctl bootout "gui/$USER_ID" "$AGENT_PATH" >/dev/null 2>&1 || true
launchctl bootstrap "gui/$USER_ID" "$AGENT_PATH"
launchctl enable "gui/$USER_ID/com.selectpilot.bridge"

exit 0
