    <key>CHROMEAI_OLLAMA_NUM_CTX</key><string>__OLLAMA_NUM_CTX__</string>
    <key>CHROMEAI_OLLAMA_FAST_NUM_CTX</key><string>__OLLAMA_FAST_NUM_CTX__</string>
    <key>CHROMEAI_MAX_INPUT_CHARS</key><string>__MAX_INPUT_CHARS__</string>
    <key>CHROMEAI_OLLAMA_SEED</key><string>__OLLAMA_SEED__</string>
    <key>CHROMEAI_BINARY_HASH</key><string>__BINARY_HASH__</string>
    <key>CHROMEAI_AUTO_PULL_MODELS</key><string>0</string>
  </dict>
</dict>
</plist>
