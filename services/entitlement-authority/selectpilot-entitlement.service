[Unit]
Description=SelectPilot entitlement authority
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/selectpilot-entitlement
ExecStart=/usr/bin/node /opt/selectpilot-entitlement/server.mjs
Environment=HOST=127.0.0.1
Environment=PORT=8091
Environment=SELECTPILOT_ENTITLEMENT_KEY_ID=selectpilot-prod-2026-01
Environment=SELECTPILOT_ENTITLEMENT_PRIVATE_KEY_FILE=%d/entitlement_private_key
Environment=SELECTPILOT_PADDLE_WEBHOOK_SECRET_FILE=%d/paddle_webhook_secret
Environment=SELECTPILOT_PADDLE_PRICE_MAP_FILE=%d/paddle_price_map
Environment=SELECTPILOT_ENTITLEMENT_STATE_FILE=/var/lib/selectpilot-authority/entitlements.json
Environment=SELECTPILOT_WEB_ORIGIN=https://selectpilot.app
LoadCredential=entitlement_private_key:/etc/selectpilot/secrets/entitlement-ed25519.pem
LoadCredential=paddle_webhook_secret:/etc/selectpilot/secrets/paddle-webhook-secret
LoadCredential=paddle_price_map:/etc/selectpilot/secrets/paddle-price-map.json
StateDirectory=selectpilot-authority
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
IPAddressDeny=any
IPAddressAllow=localhost
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target
